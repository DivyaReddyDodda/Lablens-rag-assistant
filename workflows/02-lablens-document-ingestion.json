      "name": "Edit Fields"
    },
    {
      "parameters": {
        "jsCode": "const document = $input.first().json;\n\nconst chunkSize = 800;\nconst overlap = 150;\nconst stepSize = chunkSize - overlap;\nconst chunks = [];\n\nfor (\n  let start = 0, chunkNumber = 1;\n  start < document.text.length;\n  start += stepSize, chunkNumber++\n) {\n  const chunkText = document.text\n    .slice(start, start + chunkSize)\n    .trim();\n\n  if (chunkText) {\n    const record = {\n      _id: `${document.document_id}-chunk-${chunkNumber}`,\n      text: chunkText,\n      document_id: document.document_id,\n      source_file: document.source_file,\n      chunk_number: chunkNumber\n    };\n\n    chunks.push({\n      json: {\n        ...record,\n        ndjson: JSON.stringify(record)\n      }\n    });\n  }\n}\n\nreturn chunks;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
